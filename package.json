    "build:types": "pnpm --filter @tudongnro/shared-types build"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "ignoredBuiltDependencies": ["@scarf/scarf"]
  },
  "packageManager": "pnpm@11.1.2"
}
