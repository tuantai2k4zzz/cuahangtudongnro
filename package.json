{
  "name": "tudongnrott-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Nền tảng bán và quản lý tool game NRO Online - TUDONGNROTT.com",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build:web": "pnpm --filter web build",
