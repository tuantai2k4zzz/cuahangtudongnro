# ========================================================
# CẤU HÌNH HỆ THỐNG TUDONGNROTT.COM
# ========================================================

# Cổng khởi chạy máy chủ Backend
PORT=4000
NODE_ENV=development

# Địa chỉ Frontend (cho phép CORS và nhận diện Cookies)
CLIENT_URL=http://localhost:3000

# ========================================================
# CƠ SỞ DỮ LIỆU MONGODB
# ========================================================
# Kết nối MongoDB cục bộ (Docker) hoặc MongoDB Atlas trên đám mây
MONGODB_URI=mongodb://admin:secretpassword123@localhost:27017/tudongnro?authSource=admin

# ========================================================
# XÁC THỰC BẢO MẬT JWT (JSON WEB TOKEN)
# ========================================================
JWT_ACCESS_SECRET=tudongnrott_jwt_access_super_secret_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=tudongnrott_jwt_refresh_super_secret_key_2026
JWT_REFRESH_EXPIRES_IN=7d

# ========================================================
# THÔNG TIN TÀI KHOẢN NHẬN TIỀN VIETQR
# ========================================================
BANK_CODE=MB
BANK_ACCOUNT=0865903707
BANK_ACCOUNT_NAME=BUI TUAN TAI

# Khóa bí mật kiểm tra chữ ký Webhook (HMAC SHA256)
PAYMENT_WEBHOOK_SECRET=vietqr_webhook_secret_hmac_sha256_key_2026

# ========================================================
# TÍCH HỢP CỔNG TỰ ĐỘNG BẮT BIẾN ĐỘNG SỐ DƯ (TÙY CHỌN)
# ========================================================
# SePAY (sepay.vn - Hỗ trợ bắt biến động MBBank tự động 24/7)
SEPAY_API_KEY=your_sepay_api_token_here

# PayOS (payos.vn - Cổng thanh toán chuẩn VietQR có webhook)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# ========================================================
# THÔNG BÁO TELEGRAM CHO ADMIN KHI CÓ ĐƠN HÀNG MỚI (TÙY CHỌN)
# ========================================================
# Tạo bot qua @BotFather và lấy chat ID qua @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ========================================================
# TÀI KHOẢN ADMIN MẶC ĐỊNH KHỞI TẠO BAN ĐẦU
# ========================================================
ADMIN_DEFAULT_EMAIL=admin@tudongnrott.com
ADMIN_DEFAULT_PASSWORD=AdminPassword2026@
